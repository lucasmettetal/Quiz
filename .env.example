# Copy to .env.local (dev) or set in Vercel → Project → Settings → Environment Variables.
#
# Everything prefixed with VITE_ is PUBLIC: it is embedded in the JavaScript
# sent to every browser. Only the values below belong here.
#
# NEVER put here (or anywhere in the frontend): the Supabase service_role /
# secret key, SMTP host/user/password, a Resend API key, or any Vercel token.
# SMTP is configured in the Supabase dashboard (Authentication → Emails → SMTP).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: show the "Continue with Google" button (enable the provider in Supabase first).
# VITE_ENABLE_GOOGLE_AUTH=true

# Optional: base URL used in auth e-mail links. Leave empty to use the current
# origin (localhost in dev, the Vercel domain in production). Set it when you
# want every link to point to your custom domain, e.g. https://tilt.example.com
# VITE_PUBLIC_SITE_URL=
